# Funnel Network Engine — configuration template.
# Copy to .env (same folder) and uncomment/fill what you need. Never commit .env.

# --- LLM provider (required for automated research) -------------------------
# One of: nvidia (default) | anthropic | openrouter
#FUNNEL_LLM_PROVIDER=nvidia

# The active provider's key is the only one the engine uses:
#NVIDIA_API_KEY=nvapi-...        # get it at build.nvidia.com
#ANTHROPIC_API_KEY=sk-ant-...    # get it at console.anthropic.com
#OPENROUTER_API_KEY=sk-or-...    # get it at openrouter.ai/keys

# --- Web search (recommended) ------------------------------------------------
# NVIDIA has no built-in web search; Tavily supplies scraped source context.
# Without it, evidence is model-recalled and marked unverified.
#TAVILY_API_KEY=tvly-...         # free tier at tavily.com

# --- Model overrides (optional; per tier or one-for-all) ---------------------
#NVIDIA_MODEL=meta/llama-3.1-70b-instruct
#NVIDIA_MODEL_HIGH=meta/llama-3.1-8b-instruct
#NVIDIA_MODEL_PRO=meta/llama-3.1-70b-instruct
#NVIDIA_MODEL_DEEP=meta/llama-3.1-70b-instruct
#ANTHROPIC_MODEL=...             # or ANTHROPIC_MODEL_HIGH/_PRO/_DEEP
#OPENROUTER_MODEL=deepseek/deepseek-chat   # or OPENROUTER_MODEL_HIGH/_PRO/_DEEP

# --- ISR knowledge base (optional) --------------------------------------------
# Auto-detected when the Investment_Strategy_Research_2026 repo sits beside this
# one. Point at another SQLite path, or set empty to disable.
#FUNNEL_ISR_DB=/path/to/research_workflow.sqlite3

# --- Storage (optional) --------------------------------------------------------
#FUNNEL_HOME=~/.funnel_network_engine   # database + exports root
#FUNNEL_EXPORT_DIR=                      # override just the exports folder
#FUNNEL_SKIP_ENRICH=1                    # skip yfinance/LLM company enrichment
